#!/usr/bin/env bash
# Erstellt eine geprüfte Kopie der physiobook-Datenbank. Läuft als Benutzer physiobook-svc
# (aufgerufen von borgmatic über setpriv), damit -wal/-shm nie root gehören.
#
# Exit-Codes: 0 ok · 2 Datenbank fehlt · 3 nicht von der laufenden App geöffnet
#             4 integrity_check nicht ok · 5 Fehler bei .backup/Schreiben/Parametern
set -euo pipefail
umask 077

DB="${PHYSIOBOOK_DB:-/var/lib/physiobook/db/physiobook.sqlite}"
REPO="${PHYSIOBOOK_REPO:-/opt/physiobook}"
DIR="${BACKUP_DIR:-/var/backups/physiobook}"
KEEP="${KEEP:-24}"

fail() { echo "physiobook-backup-snapshot: $2" >&2; exit "$1"; }

[[ "$KEEP" =~ ^[1-9][0-9]*$ ]] || fail 5 "KEEP muss eine positive Zahl sein: $KEEP"
[[ -f "$DB" ]] || fail 2 "Datenbank fehlt: $DB"
DB="$(realpath -e -- "$DB")"

# Nur sichern, was die App wirklich benutzt. Sonst sichern wir nach einem
# Update still eine veraltete Kopie.
open_by_app=0
for fd in /proc/[0-9]*/fd/*; do
  if [[ "$(readlink -- "$fd" 2>/dev/null || true)" == "$DB" ]]; then
    open_by_app=1
    break
  fi
done
[[ "$open_by_app" -eq 1 ]] || fail 3 "kein laufender Prozess hat $DB geöffnet"

stamp="$(date +%Y%m%d_%H%M%S)"
tmp="$DIR/.tmp-$stamp.sqlite"
final="$DIR/physiobook_$stamp.sqlite"
trap 'rm -f -- "$tmp" "$tmp-wal" "$tmp-shm" "$tmp-journal"' EXIT

# Online-Backup-API: konsistent trotz laufender Schreibzugriffe, inklusive WAL
sqlite3 -batch -init /dev/null -cmd ".timeout 10000" "$DB" ".backup '$tmp'" \
  || fail 5 ".backup fehlgeschlagen"

# Kopie eigenständig machen (keine -wal/-shm daneben), dann prüfen
sqlite3 -batch -init /dev/null "$tmp" "PRAGMA journal_mode=DELETE;" >/dev/null \
  || fail 5 "journal_mode konnte nicht gesetzt werden"
result="$(sqlite3 -batch -init /dev/null "$tmp" "PRAGMA integrity_check;")" \
  || fail 4 "integrity_check konnte nicht ausgeführt werden"
[[ "$result" == "ok" ]] || fail 4 "integrity_check: ${result:0:200}"

mv -- "$tmp" "$final" || fail 5 "Umbenennen fehlgeschlagen"
ln -f -- "$final" "$DIR/latest.sqlite" || fail 5 "latest.sqlite konnte nicht gesetzt werden"

# Rotation: Dateinamen sind nach Zeit sortierbar, die neuesten KEEP bleiben
mapfile -t old < <(printf '%s\n' "$DIR"/physiobook_*.sqlite | sort -r | tail -n +"$((KEEP + 1))")
if [[ "${#old[@]}" -gt 0 ]]; then
  rm -f -- "${old[@]}" || fail 5 "alte Kopien konnten nicht gelöscht werden"
fi

# Code-Stand festhalten, damit eine Wiederherstellung dieselbe Version baut.
# Fehler hier brechen das Backup nicht ab (HOME setzen: /root/.gitconfig ist für den Dienst-Benutzer nicht lesbar).
if commit="$(HOME="$REPO" git -C "$REPO" rev-parse HEAD 2>/dev/null)"; then
  dirty="$(HOME="$REPO" git -C "$REPO" status --porcelain --untracked-files=no 2>/dev/null | wc -l)"
  printf 'commit %s\nbranch %s\ndirty %s\nstamp %s\n' "$commit" \
    "$(HOME="$REPO" git -C "$REPO" rev-parse --abbrev-ref HEAD 2>/dev/null)" "$dirty" "$stamp" \
    > "$DIR/deployed-commit.txt" || echo "physiobook-backup-snapshot: Warnung: deployed-commit.txt nicht geschrieben" >&2
else
  echo "physiobook-backup-snapshot: Warnung: kein Git-Repo in $REPO" >&2
fi

echo "ok $(basename -- "$final") $(stat -c %s -- "$final")"
