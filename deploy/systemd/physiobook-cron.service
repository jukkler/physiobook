[Unit]
Description=physiobook Hintergrundaufgaben (Erinnerungen, E-Mail-Versand)
After=physiobook.service

[Service]
Type=oneshot
User=physiobook-svc
Group=physiobook-svc
EnvironmentFile=/opt/physiobook/.env
ExecStart=/usr/bin/curl -sf --max-time 120 -X POST -H "Authorization: Bearer ${CRON_SECRET}" http://127.0.0.1:3000/api/cron -o /dev/null

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
